<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.termux.tests</groupId>
  <artifactId>native-renderer-regressions</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Standalone native renderer and recorded PTY regressions</name>
  <properties>
    <repo.root>${project.basedir}/../..</repo.root>
    <native.tests.build.dir>${project.basedir}/target</native.tests.build.dir>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <robolectric.version>4.14.1</robolectric.version>
    <monitor.version>1.7.2</monitor.version>
    <espresso.version>3.6.1</espresso.version>
    <fixtures>${project.basedir}/fixtures</fixtures>
    <evidence>${project.build.directory}/evidence</evidence>
    <evidence.png>false</evidence.png>
    <robolectric.dependency.repo.url>https://repo.maven.apache.org/maven2</robolectric.dependency.repo.url>
  </properties>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>google</id>
      <url>https://dl.google.com/dl/android/maven2/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>robolectric</artifactId>
      <version>${robolectric.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>android-all</artifactId>
      <version>14-robolectric-10818077</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>androidx.annotation</groupId>
      <artifactId>annotation-jvm</artifactId>
      <version>1.9.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${native.tests.build.dir}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>compile-current-project-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${repo.root}/terminal-emulator/src/main/java</source>
                <source>${repo.root}/terminal-view/src/main/java</source>
                <source>${project.basedir}/compile-only</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>reuse-native-regression-tests-in-place</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${repo.root}/terminal-view/src/testNative/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Maven cannot load classes.jar nested in an AAR. Resolve pinned AARs
           normally, then extract only classes.jar into disposable build output. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>resolve-androidx-aar-classes</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>androidx.test</groupId><artifactId>monitor</artifactId>
                  <version>${monitor.version}</version><type>aar</type>
                  <outputDirectory>${project.build.directory}/aars</outputDirectory>
                  <destFileName>monitor.aar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>androidx.test.espresso</groupId><artifactId>espresso-idling-resource</artifactId>
                  <version>${espresso.version}</version><type>aar</type>
                  <outputDirectory>${project.build.directory}/aars</outputDirectory>
                  <destFileName>espresso.aar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>extract-androidx-aar-classes</id>
            <phase>generate-test-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <ant antfile="${project.basedir}/extract-aar-classes.xml">
                  <property name="build.dir" value="${project.build.directory}"/>
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>-Xmx2g</argLine>
          <failIfNoTests>true</failIfNoTests>
          <systemPropertyVariables>
            <fixtures>${fixtures}</fixtures>
            <evidence>${evidence}</evidence>
            <evidence.png>${evidence.png}</evidence.png>
            <robolectric.dependency.repo.url>${robolectric.dependency.repo.url}</robolectric.dependency.repo.url>
          </systemPropertyVariables>
          <additionalClasspathElements>
            <additionalClasspathElement>${project.build.directory}/aar-classes/monitor.jar</additionalClasspathElement>
            <additionalClasspathElement>${project.build.directory}/aar-classes/espresso.jar</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
